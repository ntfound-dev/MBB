NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Jalur permintaan perusahaan / CV terpisah dari PODH.
NEXT_PUBLIC_REQUEST_WHATSAPP_URL=
NEXT_PUBLIC_CV_NAME=

# Aktifkan tombol "Masuk" hanya setelah backend auth aman tersedia.
NEXT_PUBLIC_ENABLE_ACCOUNT=false

# PODH Laravel API
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-side URL Laravel API. Jangan tambahkan token/secret ke NEXT_PUBLIC_*.
PODH_API_URL=http://127.0.0.1:8000/api
